# Build
/target/
/docs/book/book/

# Database
*.db
*.db-shm
*.db-wal

# Automatic pre-upgrade snapshots (create_pre_upgrade_backup_if_needed in
# tack-db's migrations.rs; named "<db-file>.before-<migration-name>.sqlite")
*.before-*.sqlite

# Config (keep the example)
tack.toml
.env

# Storage
/storage/

# Logs
/logs/

# QA artifact (generated; not source)
/qa-report.html

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local tunnel config (machine-specific)
cloudflared.yml

# Stray root npm installs (frontend deps live in frontend/)
/node_modules/

# Scratch tests: an agent's or a person's local proof. Cargo discovers and runs
# them like any tests/*.rs; git never sees them, and a tracked one fails
# scripts/maintainability.py check.
/crates/*/tests/scratch_*.rs

# E2E (Playwright) artifacts
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/playwright/.cache/
/frontend/.last-run.json
# E2E runtime data — API webServer runs from frontend/ (see playwright.config.ts)
/frontend/storage-e2e/
/frontend/e2e.db
/frontend/e2e.db-shm
/frontend/e2e.db-wal
# The e2e webServer is a plain `tack serve` with an embedded runner always
# wired in (VI-B3) — this is its default state dir (session, journal,
# secret-metadata sidecar), created the first time a spec turns it on.
/frontend/.tack-runner/

# Generated by scripts/gen-deny-toml.sh (make deny / CI's `deny` job)
/deny.toml
/crates/tack-desktop/deny.toml

# tack-desktop: the Tauri sidecar binary (built per-platform, never portable
# across machines) and Tauri's own generated schema/target directories. The
# icon set `cargo tauri icon` renders IS committed — `generate_context!` reads
# it at compile time, so a clone without it cannot build the crate.
/crates/tack-desktop/binaries/*
!/crates/tack-desktop/binaries/.gitkeep
/crates/tack-desktop/gen/
/crates/tack-desktop/target/
